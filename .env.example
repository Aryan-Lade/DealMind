# ===================================================
# DealMind Environment Configuration
# ===================================================

# --- Railway PostgreSQL Database ---
# Option 1: Railway Public Database URL (Recommended)
DATABASE_PUBLIC_URL=postgresql://${{PGUSER}}:${{PGPASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}

# Option 2: Discrete Railway PostgreSQL Variables
PGUSER=postgres
PGPASSWORD=your_railway_password_here
RAILWAY_TCP_PROXY_DOMAIN=roundhouse.proxy.rlwy.net
RAILWAY_TCP_PROXY_PORT=12345
PGDATABASE=railway

# --- Backend Server Configuration ---
PORT=5000
JWT_SECRET=dealmind_jwt_secret_key_railway_2026

# --- Frontend Environment Variables ---
# API Backend URL (Leave empty in local dev to use Vite proxy /api)
VITE_API_URL=

# Google Gemini API Key (Optional - enables real AI responses)
# Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
